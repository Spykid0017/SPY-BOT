# FEI XMD — public bot defaults. Keep provider keys and real secrets out of Git.
BOT_NAME=𝐒𝐏𝐘 𝐁𝐎𝐓
BOT_VERSION=1.0.0
# Set any non-empty prefix: ., !, !!, fei, #, etc. Quote values containing spaces.
PREFIX=.
OWNER_NAME=Divine dev
# This public build has one configured owner number.
OWNER_NUMBER=2349017790750
BOT_MODE=public
LOG_LEVEL=info

# Official 𝐒𝐏𝐘 𝐁𝐎𝐓 pairing portal and bot menu artwork.
BOT_URL=https://fei-xmd.benfeilab.com
BOT_IMAGE_URL=https://res.cloudinary.com/dqqyvozdw/image/upload/v1794661365/o5jhmwztvs9yvgp1dpgt.jpg

FEI_SESSION_DIR=./auth_info_baileys
FEI_DATA_DIR=./data

# Optional PostgreSQL / Neon connection for future database-backed features.
DATABASE_URL=

# Optional non-interactive pairing number (country code + digits, no + sign).
PAIRING_NUMBER=

